// Firestore security rules — Stage 0 Teacher Auth Gate + Anti-Leak (lepidos-map).
// rules_version '2'

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks if the caller is an authenticated teacher in /users
    function isTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher";
    }

    // ──────────────────────────────────────────────────────────────
    // teachers/{teacherId}
    // ──────────────────────────────────────────────────────────────
    // Created manually by project owner in Firebase console.
    // Teachers can read their own record to verify teacher status.
    match /teachers/{teacherId} {
      allow read: if request.auth != null && request.auth.uid == teacherId;
      allow write: if false;
    }

    // ──────────────────────────────────────────────────────────────
    // quizSessions/{sessionCode}
    // ──────────────────────────────────────────────────────────────
    // Written by window.firebaseCreateSession(sessionCode, config)
    // Only authenticated teachers can create sessions.
    // Read by students to validate that a session exists and get basic metadata.
    // Does NOT contain customQuestions or answer keys.
    match /quizSessions/{sessionCode} {
      allow create: if
          isTeacher()
          && request.resource.data.createdAt == request.time
          && request.resource.data.active is bool
          && (request.resource.data.config == null
              || request.resource.data.config is map);

      allow update, delete: if false;

      // Sessions must be listable/gettable by code so students can join.
      allow read;
    }

    // ──────────────────────────────────────────────────────────────
    // quizSessions/{sessionCode}/quizContent/{docId} (sub-collection)
    // ──────────────────────────────────────────────────────────────
    // This subcollection is still readable by anyone with the session code once they know the path —
    // this stage stops the casual, drive-by leak (reading the whole session document without even opening the quiz),
    // it does not achieve full cheat-proofing. That requires server-side grading, planned for a later stage.
    match /quizSessions/{sessionCode}/quizContent/{docId} {
      allow create: if isTeacher();
      allow update, delete: if false;
      allow read; // students need this to actually receive the questions to take the quiz
    }

    // ──────────────────────────────────────────────────────────────
    // quizSessions/{sessionCode}/results/{resultId} (sub-collection)
    // ──────────────────────────────────────────────────────────────
    // Written by window.firebaseSaveQuizResult(...)
    match /quizSessions/{sessionCode}/results/{resultId} {
      allow create: if
          request.resource.data.sessionCode == sessionCode
          && request.resource.data.sessionCode is string
          && request.resource.data.sessionCode.size() > 0
          && request.resource.data.studentName is string
          && request.resource.data.studentName.size() > 0
          && request.resource.data.studentName.size() <= 100
          && request.resource.data.score is number
          && request.resource.data.score >= 0
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.score <= request.resource.data.total
          && (request.resource.data.timeTaken == null
              || (request.resource.data.timeTaken is number
                  && request.resource.data.timeTaken >= 0))
          && request.resource.data.answers is list
          && request.resource.data.completedAt == request.time
          && request.resource.data.studentUid is string
          && request.resource.data.studentUid.size() > 0
          && request.resource.data.studentDisplayName is string
          && request.resource.data.studentDisplayName.size() > 0
          && request.resource.data.studentDisplayName.size() <= 100;

      allow update, delete: if false;

      // Only authenticated teachers can read class results/gradebook
      allow read: if isTeacher();
    }

    // ──────────────────────────────────────────────────────────────
    // Nation Simulation — Stage 1: Multiplayer Foundation
    // ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isMemberOfNationTeam(gameId, nationId, uid) {
      let ownerTeamId = get(/databases/$(database)/documents/simGames/$(gameId)/nations/$(nationId)).data.ownerTeamId;
      let team = get(/databases/$(database)/documents/simGames/$(gameId)/teams/$(ownerTeamId)).data;
      return team.members.leader.claimedByUid == uid
          || team.members.military.claimedByUid == uid
          || team.members.intelligence.claimedByUid == uid
          || team.members.economy.claimedByUid == uid
          || team.members.planner.claimedByUid == uid;
    }

    function canReadSimGame(gameId) {
      let gameData = get(/databases/$(database)/documents/simGames/$(gameId)).data;
      return (isTeacher() && gameData.teacherId == request.auth.uid)
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
               && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teacherId == gameData.teacherId)
          || !exists(/databases/$(database)/documents/users/$(request.auth.uid));
          // ^ the last branch is a deliberate, temporary allowance for legacy anonymous
          // join-code players, who have no account document at all. Remove this branch
          // when the join-code path itself is removed in Stage 2 of this migration —
          // leave a comment saying exactly this, so it isn't mistaken for a permanent policy.
    }

    match /simGames/{gameId} {
      allow create: if isTeacher();
      allow read: if isSignedIn() && canReadSimGame(gameId);
      // Allow teacher to update any field; allow signed-in players to advance season clock fields or claim/release resolution lock
      allow update: if (isTeacher() && resource.data.teacherId == request.auth.uid)
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seasonIdx', 'year', 'currentSeasonStartedAt', 'status', 'resolvingSeasonLock']));
      allow delete: if false;

      match /teams/{teamId} {
        allow read: if isSignedIn() && canReadSimGame(gameId);
        allow create: if isTeacher()
          && get(/databases/$(database)/documents/simGames/$(gameId)).data.teacherId == request.auth.uid;
        // Teacher can update team info/nationId/reset codes; signed-in players can update members to claim their role
        allow update: if (isTeacher() && get(/databases/$(database)/documents/simGames/$(gameId)).data.teacherId == request.auth.uid)
          || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']));
        allow delete: if false;
      }

      match /nations/{nationId} {
        allow read: if isSignedIn();
        allow create: if isTeacher()
          && get(/databases/$(database)/documents/simGames/$(gameId)).data.teacherId == request.auth.uid;
        // Role- and team-scoped update permissions (Stage 2 Hardening & Stage 5 Extensions)
        allow update: if isSignedIn() && (
             (get(/databases/$(database)/documents/simGames/$(gameId)/teams/$(resource.data.ownerTeamId)).data.members.military.claimedByUid == request.auth.uid
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['troops','infantry','archers','cavalry','expeditionaryForce','consumption','budget','decrees','activeSupportRequestId'])
               && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['budget']) || (
                     request.resource.data.budget.economy == resource.data.budget.economy
                  && request.resource.data.budget.planning == resource.data.budget.planning
                  && request.resource.data.budget.intelligence == resource.data.budget.intelligence
               )))
          || (get(/databases/$(database)/documents/simGames/$(gameId)/teams/$(resource.data.ownerTeamId)).data.members.economy.claimedByUid == request.auth.uid
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gold','treasury','food','metals','livestock','consumption','taxPolicy','budget','decrees'])
               && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['budget']) || (
                     request.resource.data.budget.military == resource.data.budget.military
                  && request.resource.data.budget.planning == resource.data.budget.planning
                  && request.resource.data.budget.intelligence == resource.data.budget.intelligence
               )))
          || (get(/databases/$(database)/documents/simGames/$(gameId)/teams/$(resource.data.ownerTeamId)).data.members.intelligence.claimedByUid == request.auth.uid
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['budget','decrees'])
               && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['budget']) || (
                     request.resource.data.budget.military == resource.data.budget.military
                  && request.resource.data.budget.economy == resource.data.budget.economy
                  && request.resource.data.budget.planning == resource.data.budget.planning
               )))
          || (get(/databases/$(database)/documents/simGames/$(gameId)/teams/$(resource.data.ownerTeamId)).data.members.planner.claimedByUid == request.auth.uid
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['territory','decrees','budget','safeRoute'])
               && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['budget']) || (
                     request.resource.data.budget.military == resource.data.budget.military
                  && request.resource.data.budget.economy == resource.data.budget.economy
                  && request.resource.data.budget.intelligence == resource.data.budget.intelligence
               )))
          || (get(/databases/$(database)/documents/simGames/$(gameId)/teams/$(resource.data.ownerTeamId)).data.members.leader.claimedByUid == request.auth.uid
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allies','enemies','truces','decrees','budget','treasury','gold']))
          // Stage 5: Expedition support: sender applies the agreed transfer to the host nation
          || (isSignedIn()
               && resource.data.activeSupportRequestId != null
               && get(/databases/$(database)/documents/simGames/$(gameId)/expeditionRequests/$(resource.data.activeSupportRequestId)).data.status == "approved_pending_transfer"
               && isMemberOfNationTeam(
                    gameId,
                    get(/databases/$(database)/documents/simGames/$(gameId)/expeditionRequests/$(resource.data.activeSupportRequestId)).data.senderNationId,
                    request.auth.uid)
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['troops','consumption','activeSupportRequestId']))
          // Stage 5: Expedition support ending: voluntary withdrawal (sender) or automatic expulsion (whoever holds the resolver claim)
          || (isSignedIn()
               && resource.data.activeSupportRequestId != null
               && (
                    (get(/databases/$(database)/documents/simGames/$(gameId)/expeditionRequests/$(resource.data.activeSupportRequestId)).data.status == "withdrawing"
                      && isMemberOfNationTeam(gameId, get(/databases/$(database)/documents/simGames/$(gameId)/expeditionRequests/$(resource.data.activeSupportRequestId)).data.senderNationId, request.auth.uid))
                 || (get(/databases/$(database)/documents/simGames/$(gameId)/expeditionRequests/$(resource.data.activeSupportRequestId)).data.resolvingUid == request.auth.uid)
                  )
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['troops','consumption','activeSupportRequestId']))
          // Stage 5: Sender nation reversal during automatic expulsion resolution
          || (
               resource.data.expeditionaryForce != null
            && exists(/databases/$(database)/documents/simGames/$(gameId)/expeditionRequests/$(resource.data.expeditionaryForce.target))
            && get(/databases/$(database)/documents/simGames/$(gameId)/expeditionRequests/$(resource.data.expeditionaryForce.target)).data.resolvingUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['troops', 'consumption', 'expeditionaryForce', 'infantry', 'cavalry', 'archers', 'decrees'])
          )
          || (get(/databases/$(database)/documents/simGames/$(gameId)).data.resolvingSeasonLock.uid == request.auth.uid)
          || (get(/databases/$(database)/documents/simGames/$(gameId)).data.teacherId == request.auth.uid)
        );
        allow delete: if false;
      }

      // ──────────────────────────────────────────────────────────────
      // Nation Simulation — Stage 2 & 3: Caravans, Scouts, Logs, Spies
      // ──────────────────────────────────────────────────────────────
      match /caravans/{caravanId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && (
             isMemberOfNationTeam(gameId, request.resource.data.from, request.auth.uid)
          || get(/databases/$(database)/documents/simGames/$(gameId)).data.resolvingSeasonLock.uid == request.auth.uid
        );
        allow update: if isSignedIn() && (
             isMemberOfNationTeam(gameId, resource.data.from, request.auth.uid)
          || get(/databases/$(database)/documents/simGames/$(gameId)).data.resolvingSeasonLock.uid == request.auth.uid
        );
        allow delete: if get(/databases/$(database)/documents/simGames/$(gameId)).data.teacherId == request.auth.uid
          || get(/databases/$(database)/documents/simGames/$(gameId)).data.resolvingSeasonLock.uid == request.auth.uid;
      }

      match /scouts/{scoutId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isMemberOfNationTeam(gameId, request.resource.data.nation, request.auth.uid);
        allow update: if isSignedIn() && (
             isMemberOfNationTeam(gameId, resource.data.nation, request.auth.uid)
          || get(/databases/$(database)/documents/simGames/$(gameId)).data.resolvingSeasonLock.uid == request.auth.uid
        );
        allow delete: if get(/databases/$(database)/documents/simGames/$(gameId)).data.teacherId == request.auth.uid
          || isMemberOfNationTeam(gameId, resource.data.nation, request.auth.uid)
          || isSignedIn();
      }

      match /eventsLog/{eventId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false;
      }

      match /capturedSpies/{spyId} {
        // Read strictly restricted to the origin team and the capturing team
        allow read: if isSignedIn() && (
             isMemberOfNationTeam(gameId, resource.data.originNationId, request.auth.uid)
          || isMemberOfNationTeam(gameId, resource.data.captorNationId, request.auth.uid)
        );
        allow create: if isSignedIn();
        // Only the capturing team decides ransom/execute
        allow update: if isSignedIn() && isMemberOfNationTeam(gameId, resource.data.captorNationId, request.auth.uid);
        allow delete: if get(/databases/$(database)/documents/simGames/$(gameId)).data.teacherId == request.auth.uid;
      }

      // ──────────────────────────────────────────────────────────────
      // Nation Simulation — Stage 5: Military Support Request System
      // ──────────────────────────────────────────────────────────────
      match /expeditionRequests/{requestId} {
        allow read: if isSignedIn() && (
             isMemberOfNationTeam(gameId, resource.data.hostNationId, request.auth.uid)
          || isMemberOfNationTeam(gameId, resource.data.senderNationId, request.auth.uid)
        );

        allow create: if isSignedIn()
          && isMemberOfNationTeam(gameId, request.resource.data.hostNationId, request.auth.uid)
          && request.resource.data.status == "pending_request"
          && request.resource.data.senderNationId in get(/databases/$(database)/documents/simGames/$(gameId)/nations/$(request.resource.data.hostNationId)).data.allies;

        allow update: if isSignedIn() && (
             (isMemberOfNationTeam(gameId, resource.data.senderNationId, request.auth.uid)
               && resource.data.status == "pending_request"
               && (request.resource.data.status == "rejected" || request.resource.data.status == "approved_pending_transfer"))
          || (isMemberOfNationTeam(gameId, resource.data.senderNationId, request.auth.uid)
               && resource.data.status == "approved_pending_transfer"
               && request.resource.data.status == "active")
          || (isMemberOfNationTeam(gameId, resource.data.senderNationId, request.auth.uid)
               && (resource.data.status == "active" || resource.data.status == "withdrawal_requested" || resource.data.status == "expulsion_notice")
               && (request.resource.data.status == "withdrawing" || request.resource.data.status == "withdrawn" || request.resource.data.status == "withdrawal_refused"))
          || (isMemberOfNationTeam(gameId, resource.data.hostNationId, request.auth.uid)
               && resource.data.status == "active"
               && request.resource.data.status == "withdrawal_requested")
          || (isMemberOfNationTeam(gameId, resource.data.hostNationId, request.auth.uid)
               && resource.data.status == "withdrawal_refused"
               && request.resource.data.status == "expulsion_notice")
          || (resource.data.status == "expulsion_notice") // covers both claiming the resolver lock and the final auto-expelled write
        );

        allow delete: if get(/databases/$(database)/documents/simGames/$(gameId)).data.teacherId == request.auth.uid;
      }

      // ──────────────────────────────────────────────────────────────
      // Nation Simulation — Stage 6: Scout Intelligence, Delayed Reports & Pursuit
      // ──────────────────────────────────────────────────────────────
      match /scoutMissions/{missionId} {
        allow read: if isSignedIn() && (
             isMemberOfNationTeam(gameId, resource.data.scoutNationId, request.auth.uid)
          || isMemberOfNationTeam(gameId, resource.data.targetNationId, request.auth.uid)
        );
        allow create: if isSignedIn() && isMemberOfNationTeam(gameId, request.resource.data.scoutNationId, request.auth.uid);
        allow update: if isSignedIn() && (
             isMemberOfNationTeam(gameId, resource.data.scoutNationId, request.auth.uid)   // advancing tiers, beginning return, reporting
          || isMemberOfNationTeam(gameId, resource.data.targetNationId, request.auth.uid)  // marking "captured" after a successful pursuit, or reroute
        );
        allow delete: if get(/databases/$(database)/documents/simGames/$(gameId)).data.teacherId == request.auth.uid;

        match /report/{docId} {
          // The scouting team can only read their own findings, and only once the scout has actually made it home.
          allow read: if isSignedIn()
            && isMemberOfNationTeam(gameId, get(/databases/$(database)/documents/simGames/$(gameId)/scoutMissions/$(missionId)).data.scoutNationId, request.auth.uid)
            && get(/databases/$(database)/documents/simGames/$(gameId)/scoutMissions/$(missionId)).data.status == "reported"
            && request.time >= get(/databases/$(database)/documents/simGames/$(gameId)/scoutMissions/$(missionId)).data.reportETA;
          allow write: if isSignedIn() && isMemberOfNationTeam(gameId, get(/databases/$(database)/documents/simGames/$(gameId)/scoutMissions/$(missionId)).data.scoutNationId, request.auth.uid);
          allow delete: if get(/databases/$(database)/documents/simGames/$(gameId)).data.teacherId == request.auth.uid;
        }
      }
    }

    // ──────────────────────────────────────────────────────────────
    // Permanent Multi-Tenant Account System (Stage 1)
    // ──────────────────────────────────────────────────────────────
    function isSuperAdmin(uid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == "superAdmin";
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isOrgActive(orgId) {
      let org = get(/databases/$(database)/documents/organizations/$(orgId)).data;
      return org.tier != "demo" || (org.demoExpiresAt != null && request.time < org.demoExpiresAt);
    }

    match /organizations/{orgId} {
      allow read: if isSignedIn() && (
        isSuperAdmin(request.auth.uid)
        || (getUserData(request.auth.uid).orgId == orgId && (resource.data.tier != "demo" || (resource.data.demoExpiresAt != null && request.time < resource.data.demoExpiresAt)))
      );

      allow create: if isSuperAdmin(request.auth.uid);

      allow update: if isSuperAdmin(request.auth.uid)
        || (isSignedIn()
             && getUserData(request.auth.uid).role == "admin"
             && getUserData(request.auth.uid).orgId == orgId
             && isOrgActive(orgId)
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "adminCount"]));

      allow delete: if isSuperAdmin(request.auth.uid);
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (
        isSuperAdmin(request.auth.uid)
        || (
          (request.auth.uid == uid || getUserData(request.auth.uid).orgId == resource.data.orgId)
          && (resource.data.orgId == null || isOrgActive(resource.data.orgId))
        )
      );

      // Scoped creation based on creator role and target role/org
      allow create: if isSignedIn() && (
        isSuperAdmin(request.auth.uid)
        || (
          // Admin creating admin, itStaff, teacher, or student within their own active org
          getUserData(request.auth.uid).role == "admin"
          && getUserData(request.auth.uid).orgId == request.resource.data.orgId
          && isOrgActive(request.resource.data.orgId)
          && request.resource.data.role in ["admin", "itStaff", "teacher", "student"]
          && request.resource.data.createdByUid == request.auth.uid
        )
        || (
          // IT Staff creating teacher or student within their own active org
          getUserData(request.auth.uid).role == "itStaff"
          && getUserData(request.auth.uid).orgId == request.resource.data.orgId
          && isOrgActive(request.resource.data.orgId)
          && request.resource.data.role in ["teacher", "student"]
          && request.resource.data.createdByUid == request.auth.uid
        )
        || (
          // Teacher creating student for their own active org
          getUserData(request.auth.uid).role == "teacher"
          && getUserData(request.auth.uid).orgId == request.resource.data.orgId
          && isOrgActive(request.resource.data.orgId)
          && request.resource.data.role == "student"
          && request.resource.data.teacherId == request.auth.uid
          && request.resource.data.createdByUid == request.auth.uid
        )
      );

      allow update: if isSignedIn() && (
        isSuperAdmin(request.auth.uid)
        || (
          request.auth.uid == uid
          && (resource.data.orgId == null || isOrgActive(resource.data.orgId))
        )
        || (
          getUserData(request.auth.uid).role == "admin"
          && getUserData(request.auth.uid).orgId == resource.data.orgId
          && isOrgActive(resource.data.orgId)
        )
      );

      allow delete: if isSignedIn() && (
        isSuperAdmin(request.auth.uid)
        || (
          getUserData(request.auth.uid).orgId == resource.data.orgId
          && getUserData(request.auth.uid).role == "admin"
          && isOrgActive(resource.data.orgId)
          && (
            resource.data.role != "admin"
            || get(/databases/$(database)/documents/organizations/$(resource.data.orgId)).data.adminCount > 1
          )
        )
      );
    }

    // ──────────────────────────────────────────────────────────────
    // Explanation Mode: Research Submissions (Stage 2a)
    // ──────────────────────────────────────────────────────────────
    match /researchSubmissions/{submissionId} {
      allow read: if isSignedIn() && (
           resource.data.studentUid == request.auth.uid
        || resource.data.teacherId == request.auth.uid
        || (resource.data.status == "approved" && getUserData(request.auth.uid).teacherId == resource.data.teacherId)
      );

      allow create: if isSignedIn()
        && getUserData(request.auth.uid).role == "student"
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.teacherId == getUserData(request.auth.uid).teacherId
        && request.resource.data.status == "submitted";

      allow update: if isSignedIn() && (
           // Student may revise and resubmit their own entry, but only while it needs revision — never while it's already approved
           (resource.data.studentUid == request.auth.uid
             && resource.data.status == "needs_revision"
             && request.resource.data.status == "submitted"
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["title","summary","locationName","coords","citation","sourceUrl","status","updatedAt"]))
           // Teacher may approve or request revision, but not edit the student's actual content
        || (resource.data.teacherId == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","teacherFeedback","updatedAt"])
             && request.resource.data.status in ["needs_revision", "approved"])
      );

      allow delete: if isSignedIn() && (isSuperAdmin(request.auth.uid) || resource.data.teacherId == request.auth.uid);
    }

    // ──────────────────────────────────────────────────────────────
    // Explanation Mode: Live Control Handoff & Collaborative Drawing (Stage 2b)
    // ──────────────────────────────────────────────────────────────
    match /liveClasses/{classId} {
      allow read: if isSignedIn() && (
           resource.data.teacherId == request.auth.uid
        || getUserData(request.auth.uid).classId == classId
      );
      allow create: if isSignedIn() && getUserData(request.auth.uid).role == "teacher"
        && request.resource.data.teacherId == request.auth.uid;

      // Granting/revoking control: the teacher may set it to anyone; the current controller may relinquish it back to null themselves
      allow update: if isSignedIn() && (
           (resource.data.teacherId == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activeControllerUid", "updatedAt"]))
        || (resource.data.activeControllerUid == request.auth.uid
             && request.resource.data.activeControllerUid == null
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activeControllerUid", "updatedAt"]))
           // The current controller (teacher-with-no-one-assigned counts as controller too) may update the map view
        || ((resource.data.activeControllerUid == request.auth.uid
              || (resource.data.activeControllerUid == null && resource.data.teacherId == request.auth.uid))
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["currentMapView", "updatedAt"]))
      );
      allow delete: if isSuperAdmin(request.auth.uid) || resource.data.teacherId == request.auth.uid;

      match /handRaises/{uid} {
        allow read: if isSignedIn() && (
             get(/databases/$(database)/documents/liveClasses/$(classId)).data.teacherId == request.auth.uid
          || getUserData(request.auth.uid).classId == classId
        );
        allow create, delete: if isSignedIn() && request.auth.uid == uid;
        allow update: if false;
      }

      match /annotations/{annotationId} {
        allow read: if isSignedIn() && (
             get(/databases/$(database)/documents/liveClasses/$(classId)).data.teacherId == request.auth.uid
          || getUserData(request.auth.uid).classId == classId
        );
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && (get(/databases/$(database)/documents/liveClasses/$(classId)).data.activeControllerUid == request.auth.uid
              || (get(/databases/$(database)/documents/liveClasses/$(classId)).data.activeControllerUid == null
                  && get(/databases/$(database)/documents/liveClasses/$(classId)).data.teacherId == request.auth.uid));
        allow update: if false;
        allow delete: if get(/databases/$(database)/documents/liveClasses/$(classId)).data.teacherId == request.auth.uid;
      }
    }

    // ──────────────────────────────────────────────────────────────
    // Everything else
    // ──────────────────────────────────────────────────────────────
    // Default: every other collection/path is DENIED.
  }
}