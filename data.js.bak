            const borderDisputesData = [
                { name_ar: 'مثلث حلايب', name_en: 'Halayeb Triangle', coords: [36.2, 22.8], type: 'active', countries_ar: 'مصر، السودان', countries_en: 'Egypt, Sudan', causes_ar: 'منطقة نزاع حدودي بين مصر والسودان منذ استقلال السودان عام 1956، تطالب بها مصر كجزء من أسوان وتطالب بها السودان كجزء من ولاية البحر الأحمر.', causes_en: 'Border zone disputed between Egypt and Sudan since Sudan\'s independence in 1956; Egypt claims it as part of Aswan while Sudan claims it as part of the Red Sea State.', name_ru: 'Треугольник Халаиба', countries_ru: 'Египет, Судан', causes_ru: 'Пограничная зона, оспариваемая Египтом и Суданом с момента обретения Суданом независимости в 1956 году; Египет считает её частью Асуана, а Судан — частью провинции Красное Море.' },
                { name_ar: 'الصحراء الغربية', name_en: 'Western Sahara', coords: [-13.0, 24.5], type: 'active', countries_ar: 'المغرب، الجمهورية الصحراوية', countries_en: 'Morocco, Sahrawi Republic', causes_ar: 'نزاع على إقليم الصحراء الغربية بين المغرب وجبهة البوليساريو منذ انسحاب إسبانيا عام 1975، تدعم الجزائر البوليساريو.', causes_en: 'Territorial dispute over Western Sahara between Morocco and the Polisario Front since Spain\'s withdrawal in 1975; Algeria supports the Polisario.', name_ru: 'Западная Сахара', countries_ru: 'Марокко, Сахарская Республика', causes_ru: 'Территориальный спор о Западной Сахаре между Марокко и Фронтом ПОЛИСАРИО с момента ухода Испании в 1975 году; Алжир поддерживает ПОЛИСАРИО.' },
                { name_ar: 'كشمير', name_en: 'Kashmir', coords: [76.5, 34.5], type: 'active', countries_ar: 'الهند، باكستان، الصين', countries_en: 'India, Pakistan, China', causes_ar: 'نزاع إقليمي منذ تقسيم الهند عام 1947، الهند تطالب بكامل الإقليم وباكستان تطالب بمنطقة جامو وكشمير، والصين تحت控制 أراضي في أكساي تشين.', causes_en: 'Regional dispute since the 1947 partition of India; India claims the entire region, Pakistan claims Jammu and Kashmir, and China controls parts of Aksai Chin.' , name_ru: 'Кашмир', countries_ru: 'Индия, Пакистан, Китай', causes_ru: 'Региональный спор с момента раздела Индии в 1947 году; Индия претендует на весь регион, Пакистан — на Джамму и Кашмир, Китай контролирует часть Аксай-Чина.' },
                { name_ar: 'فلسطين-إسرائيل', name_en: 'Palestine-Israel', coords: [35.0, 31.5], type: 'active', countries_ar: 'فلسطين، إسرائيل', countries_en: 'Palestine, Israel', causes_ar: 'صراع مستمر منذ عام 1948 حول الضفة الغربية وقطاع غزة والقدس الشرقية، بالإضافة إلى قضايا اللاجئين والمستوطنات.', causes_en: 'Ongoing conflict since 1948 over the West Bank, Gaza Strip, and East Jerusalem, along with refugee and settlement issues.' , name_ru: 'Палестина-Израиль', countries_ru: 'Палестина, Израиль', causes_ru: 'Конфликт с 1948 года по Западному берегу, сектору Газа и Восточному Иерусалиму, а также вопросы беженцев и поселений.' },
                { name_ar: 'القرم', name_en: 'Crimea', coords: [34.0, 45.3], type: 'active', countries_ar: 'أوكرانيا، روسيا', countries_en: 'Ukraine, Russia', causes_ar: 'ضمتها روسيا عام 2014 بعد استفتاء مثير للجدل، ولا تزال أوكرانيا والمجتمع الدولي يعترفون بها كجزء من أوكرانيا.', causes_en: 'Annexed by Russia in 2014 after a controversial referendum; Ukraine and the international community still recognize it as part of Ukraine.' , name_ru: 'Крым', countries_ru: 'Украина, Россия', causes_ru: 'Аннексирован Россией в 2014 году после спорного референдума; Украина и международное сообщество по-прежнему признают его частью Украины.' },
                { name_ar: 'ناغورنو كاراباخ', name_en: 'Nagorno-Karabakh', coords: [46.8, 40.0], type: 'ceasefire', countries_ar: 'أرمينيا، أذربيجان', countries_en: 'Armenia, Azerbaijan', causes_ar: 'نزاع إقليمي استمر لعقود، سيطرت أرمينيا عليه ثم استعادته أذربيجان عام 2023، اتفاق وقف إطلاق نار هش.', causes_en: 'Decades-long territorial conflict; controlled by Armenia then reclaimed by Azerbaijan in 2023 under a fragile ceasefire.' , name_ru: 'Нагорный Карабах', countries_ru: 'Армения, Азербайджан', causes_ru: 'Многолетний территориальный конфликт; контролировался Арменией, затем возвращён Азербайджаном в 2023 году при хрупком режиме прекращения огня.' },
                { name_ar: 'دونباس', name_en: 'Donbas', coords: [38.0, 48.0], type: 'active', countries_ar: 'أوكرانيا، روسيا', countries_en: 'Ukraine, Russia', causes_ar: 'منطقة شرق أوكرانيا تشهد نزاعاً مسلحاً منذ 2014 بين القوات الأوكرانية والانفصاليين الموالين لروسيا.', causes_en: 'Region in eastern Ukraine experiencing armed conflict since 2014 between Ukrainian forces and Russia-backed separatists.' , name_ru: 'Донбасс', countries_ru: 'Украина, Россия', causes_ru: 'Регион восточной Украины, где с 2014 года идёт вооружённый конфликт между украинскими войсками и пророссийскими сепаратистами.' },
                { name_ar: 'أبيي', name_en: 'Abyei', coords: [28.8, 9.5], type: 'active', countries_ar: 'السودان، جنوب السودان', countries_en: 'Sudan, South Sudan', causes_ar: 'منطقة حدودية غنية بالنفط متنازع عليها بين السودان وجنوب السودان منذ استقلال الجنوب عام 2011.', causes_en: 'Oil-rich border region disputed between Sudan and South Sudan since the south\'s independence in 2011.', name_ru: 'Абьей', countries_ru: 'Судан, Южный Судан', causes_ru: 'Нефтеносный пограничный регион, оспариваемый Суданом и Южным Суданом с момента обретения югом независимости в 2011 году.' },
                { name_ar: 'بحر الصين الجنوبي', name_en: 'South China Sea', coords: [113.0, 10.0], type: 'maritime', countries_ar: 'الصين، فيتنام، الفلبين، ماليزيا، بروناي، تايوان', countries_en: 'China, Vietnam, Philippines, Malaysia, Brunei, Taiwan', causes_ar: 'نزاع بحري على جزر ومطالبات إقليمية في بحر الصين الجنوبي، تطالب الصين بخط التسعة النقاط.', causes_en: 'Maritime dispute over islands and territorial claims in the South China Sea; China claims the nine-dash line.' , name_ru: 'Южно-Китайское море', countries_ru: 'Китай, Вьетнам, Филиппины, Малайзия, Бруней, Тайвань', causes_ru: 'Морской спор об островах и территориальных претензиях в Южно-Китайском море; Китай претендует на линию из девяти пунктов.' },
                { name_ar: 'تايوان', name_en: 'Taiwan', coords: [121.0, 24.0], type: 'maritime', countries_ar: 'تايوان، الصين', countries_en: 'Taiwan, China', causes_ar: 'تطالب الصين بتايوان كجزء من أراضيها منذ نهاية الحرب الأهلية الصينية عام 1949، تايوان تدير نفسها كدولة مستقلة.', causes_en: 'China claims Taiwan as part of its territory since the end of the Chinese Civil War in 1949; Taiwan administers itself as a de facto independent state.' , name_ru: 'Тайвань', countries_ru: 'Тайвань, Китай', causes_ru: 'Китай считает Тайвань частью своей территории с момента окончания гражданской войны в Китае в 1949 году; Тайвань управляет собой как де-факто независимое государство.' },
                { name_ar: 'مرتفعات الجولان', name_en: 'Golan Heights', coords: [35.8, 33.0], type: 'active', countries_ar: 'سوريا، إسرائيل', countries_en: 'Syria, Israel', causes_ar: 'احتلت إسرائيل مرتفعات الجولان من سوريا عام 1967 وضمتها عام 1981، سوريا تطالب بعودتها.', causes_en: 'Israel captured the Golan Heights from Syria in 1967 and annexed it in 1981; Syria demands its return.' , name_ru: 'Голанские высоты', countries_ru: 'Сирия, Израиль', causes_ru: 'Израиль захватил Голанские высоты у Сирии в 1967 году и аннексировал их в 1981 году; Сирия требует их возвращения.' },
                { name_ar: 'جزر الكوريل', name_en: 'Kuril Islands', coords: [153.0, 45.0], type: 'active', countries_ar: 'روسيا، اليابان', countries_en: 'Russia, Japan', causes_ar: 'نزاع بين روسيا واليابان على الجزر الجنوبية من أرخبيل الكوريل منذ الحرب العالمية الثانية.', causes_en: 'Dispute between Russia and Japan over the southern Kuril Islands since World War II.' , name_ru: 'Курильские острова', countries_ru: 'Россия, Япония', causes_ru: 'Спор между Россией и Японией о южных Курильских островах со времён Второй мировой войны.' },
                { name_ar: 'جزر فوكلاند', name_en: 'Falkland Islands', coords: [-58.0, -51.7], type: 'ceasefire', countries_ar: 'بريطانيا، الأرجنتين', countries_en: 'UK, Argentina', causes_ar: 'نزاع على جزر فوكلاند بين بريطانيا والأرجنتين، حرب عام 1982 انتهت بانتصار بريطانيا.', causes_en: 'Dispute over the Falkland Islands between the UK and Argentina; the 1982 war ended with a British victory.' , name_ru: 'Фолклендские острова', countries_ru: 'Великобритания, Аргентина', causes_ru: 'Спор о Фолклендских островах между Великобританией и Аргентиной; война 1982 года закончилась победой Британии.' },
                { name_ar: 'جبل طارق', name_en: 'Gibraltar', coords: [-5.35, 36.14], type: 'maritime', countries_ar: 'بريطانيا، إسبانيا', countries_en: 'UK, Spain', causes_ar: 'مطالبة إسبانية بإقليم جبل طارق البريطاني منذ معاهدة أوترخت 1713.', causes_en: 'Spanish claim to the British overseas territory of Gibraltar since the Treaty of Utrecht 1713.' , name_ru: 'Гибралтар', countries_ru: 'Великобритания, Испания', causes_ru: 'Испанские претензии на британскую заморскую территорию Гибралтар с Утрехтского договора 1713 года.' },
                { name_ar: 'سيناء', name_en: 'Sinai Peninsula', coords: [34.0, 29.5], type: 'active', countries_ar: 'مصر، إسرائيل', countries_en: 'Egypt, Israel', causes_ar: 'نزاعات حدودية تاريخية حول شبه جزيرة سيناء بين مصر وإسرائيل، عادت لمصر بعد معاهدة كامب ديفيد 1979.', causes_en: 'Historical border disputes over the Sinai Peninsula between Egypt and Israel; returned to Egypt after the Camp David Accords of 1979.' , name_ru: 'Синайский полуостров', countries_ru: 'Египет, Израиль', causes_ru: 'Исторические пограничные споры о Синайском полуострове между Египтом и Израилем; возвращён Египту после Кэмп-Дэвидских соглашений 1979 года.' },
                { name_ar: 'قبرص الشمالية', name_en: 'Northern Cyprus', coords: [33.5, 35.2], type: 'ceasefire', countries_ar: 'قبرص، تركيا', countries_en: 'Cyprus, Turkey', causes_ar: 'احتلّت تركيا شمال قبرص عام 1974، وأعلنت جمهورية شمال قبرص التركية من جانب واحد، والاعتراف الدولي بقبرص الموحدة.', causes_en: 'Turkey occupied northern Cyprus in 1974; the Turkish Republic of Northern Cyprus was unilaterally declared, with international recognition for a unified Cyprus.' , name_ru: 'Северный Кипр', countries_ru: 'Кипр, Турция', causes_ru: 'Турция оккупировала север Кипра в 1974 году; Турецкая Республика Северного Кипра была провозглашена в одностороннем порядке при международном признании единого Кипра.' },
                { name_ar: 'ترانسنيستريا', name_en: 'Transnistria', coords: [29.5, 47.0], type: 'ceasefire', countries_ar: 'مولدوفا، روسيا', countries_en: 'Moldova, Russia', causes_ar: 'انفصلت ترانسنيستريا عن مولدوفا عام 1990، بدعم روسي، ولا تعترف بها أي دولة عضو في الأمم المتحدة.', causes_en: 'Transnistria broke away from Moldova in 1990 with Russian support; not recognized by any UN member state.' , name_ru: 'Приднестровье', countries_ru: 'Молдова, Россия', causes_ru: 'Приднестровье отделилось от Молдовы в 1990 году при поддержке России; не признано ни одним государством-членом ООН.' },
                { name_ar: 'أبخازيا', name_en: 'Abkhazia', coords: [41.0, 43.0], type: 'ceasefire', countries_ar: 'جورجيا، روسيا', countries_en: 'Georgia, Russia', causes_ar: 'انفصلت أبخازيا عن جورجيا في التسعينيات، واعترفت بها روسيا كدولة مستقلة بعد حرب 2008.', causes_en: 'Abkhazia broke away from Georgia in the 1990s; Russia recognized it as an independent state after the 2008 war.' , name_ru: 'Абхазия', countries_ru: 'Грузия, Россия', causes_ru: 'Абхазия отделилась от Грузии в 1990-х годах; Россия признала её независимость после войны 2008 года.' },
                { name_ar: 'أوسيتيا الجنوبية', name_en: 'South Ossetia', coords: [44.0, 42.3], type: 'ceasefire', countries_ar: 'جورجيا، روسيا', countries_en: 'Georgia, Russia', causes_ar: 'نزاع انفصالي في أوسيتيا الجنوبية عن جورجيا، اعترفت بها روسيا بعد حرب 2008.', causes_en: 'Separatist conflict in South Ossetia from Georgia; Russia recognized it after the 2008 war.' , name_ru: 'Южная Осетия', countries_ru: 'Грузия, Россия', causes_ru: 'Сепаратистский конфликт в Южной Осетии от Грузии; Россия признала её после войны 2008 года.' },
                { name_ar: 'سبتة ومليلية', name_en: 'Ceuta and Melilla', coords: [-2.9, 35.3], type: 'active', countries_ar: 'إسبانيا، المغرب', countries_en: 'Spain, Morocco', causes_ar: 'مدينتان إسبانيتان على الساحل المغربي، تطالب بهما المغرب كأراضٍ محتلة.', causes_en: 'Two Spanish cities on the Moroccan coast claimed by Morocco as occupied territories.' , name_ru: 'Сеута и Мелилья', countries_ru: 'Испания, Марокко', causes_ru: 'Два испанских города на марокканском побережье, на которые Марокко претендует как на оккупированные территории.' },
                { name_ar: 'التبت', name_en: 'Tibet', coords: [89.0, 32.0], type: 'active', countries_ar: 'الصين، حكومة التبت في المنفى', countries_en: 'China, Tibetan government-in-exile', causes_ar: 'ضمت الصين التبت عام 1950، وتطالب حكومة التبت في المنفى بالاستقلال.', causes_en: 'China annexed Tibet in 1950; the Tibetan government-in-exile claims independence.' , name_ru: 'Тибет', countries_ru: 'Китай, тибетское правительство в изгнании', causes_ru: 'Китай аннексировал Тибет в 1950 году; тибетское правительство в изгнании требует независимости.' },
                { name_ar: 'إقليم كردستان', name_en: 'Kurdistan Region', coords: [44.0, 36.0], type: 'active', countries_ar: 'العراق، إقليم كردستان', countries_en: 'Iraq, Kurdistan Region', causes_ar: 'نزاع على المناطق الكردية في العراق بين الحكومة المركزية وإقليم كردستان، خاصة كركوك.', causes_en: 'Dispute over Kurdish areas in Iraq between the central government and the Kurdistan Region, especially Kirkuk.' , name_ru: 'Регион Курдистан', countries_ru: 'Ирак, Регион Курдистан', causes_ru: 'Спор о курдских районах Ирака между центральным правительством и Регионом Курдистан, особенно о Киркуке.' }
            ];
