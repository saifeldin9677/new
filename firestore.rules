// Firestore security rules — draft for the quiz feature (lepidos-map).
// rules_version '2'
//
// STATUS: STOP-GAP, NO AUTH. Firebase Auth is initialized in firebase.js but no
// sign-in flow exists yet (no signInWithEmailAndPassword, no onAuthStateChanged).
// That means `request.auth` is always null right now, so these rules cannot tell
// a teacher from a student from a stranger. They stop *obviously wrong* writes
// (overwriting scores, malformed data, forged timestamps) but do NOT yet enforce
// "this result belongs to this student" or "only this session's teacher can read".
// Each spot that must be tightened once real sign-in lands is marked
// `// TODO(auth):`.
//
// Default behavior of Firestore rules is DENY for any path not matched below.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────
    // quizSessions/{sessionCode}
    // ──────────────────────────────────────────────────────────────
    // Written by window.firebaseCreateSession(sessionCode, config)
    //   -> setDoc(doc(db, 'quizSessions', sessionCode), {
    //        createdAt: serverTimestamp(),   // client sends serverTimestamp()
    //        active: true,
    //        config: config || null
    //      })
    // Read so a student's browser can validate that a session code
    // exists before joining.
    match /quizSessions/{sessionCode} {
      allow create: if
          request.resource.data.createdAt == request.time          // timestamp must be the server's, not client-forged
          && request.resource.data.active is bool
          && (request.resource.data.config == null
              || request.resource.data.config is map);

      // TODO(auth): once a teacher account exists, forbid student-created
      // sessions by requiring request.auth != null (and ideally that the
      // creating user is the record owner).
      //
      // TODO(auth): a future "teacher ends session" feature should reintroduce
      // a *narrow* auth-scoped rule allowing ONLY update of the `active` field
      // (e.g. allow update: if isTeacher(...) && request.resource.data.diff
      // touches nothing but `active`). Until then, client-side updates are
      // unsafe with no auth, so they are fully denied.
      allow update, delete: if false;

      // Sessions must be listable/gettable by code so students can join.
      // TODO(auth): consider restricting to "exists && active", and once auth
      // exists, hiding sessions not yet created by any known user if desired.
      allow read;
    }

    // ──────────────────────────────────────────────────────────────
    // quizSessions/{sessionCode}/results/{resultId}  (sub-collection)
    // ──────────────────────────────────────────────────────────────
    // Written by window.firebaseSaveQuizResult(...)
    //   addDoc(collection(db,'quizSessions', code.toUpperCase(), 'results'), {
    //     sessionCode, studentName, score, total,
    //     timeTaken, answers, completedAt: serverTimestamp()
    //   })
    // Read by window.firebaseGetResultsForSession(sessionCode) via
    // query(collection('quizSessions', code, 'results'),
    //       orderBy('completedAt', 'asc')).
    //
    // Results are stored UNDER the owning session code's sub-collection, so the
    // "read is scoped to a session" property is enforced by the DATABASE PATH,
    // not by a `where(...)` filter (which Firestore rules cannot inspect).
    // There is no top-level `quizResults` collection any more, so no query can
    // dump results across ALL sessions at once — an unfiltered list now
    // resolves to a path the rules do not match, i.e. DENY.
    match /quizSessions/{sessionCode}/results/{resultId} {
      // Only a genuine, well-shaped submission for THIS session can be created.
      // (`sessionCode` in the doc body must echo the path's session code too,
      // so a write can't pretend to come from a different session.)
      allow create: if
          request.resource.data.sessionCode == sessionCode
          // sessionCode: non-empty string
          && request.resource.data.sessionCode is string
          && request.resource.data.sessionCode.size() > 0
          // studentName: non-empty, sane length
          && request.resource.data.studentName is string
          && request.resource.data.studentName.size() > 0
          && request.resource.data.studentName.size() <= 100
          // score/total: numbers with sane bounds
          && request.resource.data.score is number
          && request.resource.data.score >= 0
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.score <= request.resource.data.total
          // timeTaken: null or non-negative number
          && (request.resource.data.timeTaken == null
              || (request.resource.data.timeTaken is number
                  && request.resource.data.timeTaken >= 0))
          // answers: must be a list
          && request.resource.data.answers is list
          // completedAt: MUST be the server timestamp, never client-supplied,
          // so a forged completion time/order cannot be written.
          && request.resource.data.completedAt == request.time;

      // The core defense: once a result is submitted it must never be
      // rewritten or deleted from any client. Even without knowing which
      // student submitted it, no one can tamper with a stored score. This
      // stays permanent.
      allow update, delete: if false;

      // Reads reachable ONLY through the per-session sub-collection path — a
      // client must name a specific sessionCode in the URL to read any results
      // at all, and can never list results across sessions in one query.
      // Well-formedness is still enforced per document; without auth a hostile
      // client is limited to reading the specific session code they guess,
      // one session at a time.
      //
      // Without auth this still cannot enforce "only the teacher of THIS
      // session reads" — anyone who knows/guesses a code can read that code's
      // results (same trust level as the session code itself, like joining).
      //
      // TODO(auth): replace this with `allow read: if
      //   teacherOfSession(request.auth, sessionCode)` and drop the
      //   well-formedness-only comment; the real fix makes reads teacher-only.
      allow read: if
          resource.data.sessionCode == sessionCode
          && resource.data.sessionCode is string
          && resource.data.sessionCode.size() > 0
          && resource.data.completedAt is timestamp;
    }

    // ──────────────────────────────────────────────────────────────
    // Everything else
    // ──────────────────────────────────────────────────────────────
    // No match catch-all, no .write rules anywhere: by default every other
    // collection/path is DENIED.
  }
}