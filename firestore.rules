// Firestore security rules — Stage 0 Teacher Auth Gate + Anti-Leak (lepidos-map).
// rules_version '2'

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks if the caller is an authenticated teacher whose UID exists in /teachers
    function isTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    // ──────────────────────────────────────────────────────────────
    // teachers/{teacherId}
    // ──────────────────────────────────────────────────────────────
    // Created manually by project owner in Firebase console.
    // Teachers can read their own record to verify teacher status.
    match /teachers/{teacherId} {
      allow read: if request.auth != null && request.auth.uid == teacherId;
      allow write: if false;
    }

    // ──────────────────────────────────────────────────────────────
    // quizSessions/{sessionCode}
    // ──────────────────────────────────────────────────────────────
    // Written by window.firebaseCreateSession(sessionCode, config)
    // Only authenticated teachers can create sessions.
    // Read by students to validate that a session exists and get basic metadata.
    // Does NOT contain customQuestions or answer keys.
    match /quizSessions/{sessionCode} {
      allow create: if
          isTeacher()
          && request.resource.data.createdAt == request.time
          && request.resource.data.active is bool
          && (request.resource.data.config == null
              || request.resource.data.config is map);

      allow update, delete: if false;

      // Sessions must be listable/gettable by code so students can join.
      allow read;
    }

    // ──────────────────────────────────────────────────────────────
    // quizSessions/{sessionCode}/quizContent/{docId} (sub-collection)
    // ──────────────────────────────────────────────────────────────
    // This subcollection is still readable by anyone with the session code once they know the path —
    // this stage stops the casual, drive-by leak (reading the whole session document without even opening the quiz),
    // it does not achieve full cheat-proofing. That requires server-side grading, planned for a later stage.
    match /quizSessions/{sessionCode}/quizContent/{docId} {
      allow create: if isTeacher();
      allow update, delete: if false;
      allow read; // students need this to actually receive the questions to take the quiz
    }

    // ──────────────────────────────────────────────────────────────
    // quizSessions/{sessionCode}/results/{resultId} (sub-collection)
    // ──────────────────────────────────────────────────────────────
    // Written by window.firebaseSaveQuizResult(...)
    match /quizSessions/{sessionCode}/results/{resultId} {
      allow create: if
          request.resource.data.sessionCode == sessionCode
          && request.resource.data.sessionCode is string
          && request.resource.data.sessionCode.size() > 0
          && request.resource.data.studentName is string
          && request.resource.data.studentName.size() > 0
          && request.resource.data.studentName.size() <= 100
          && request.resource.data.score is number
          && request.resource.data.score >= 0
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.score <= request.resource.data.total
          && (request.resource.data.timeTaken == null
              || (request.resource.data.timeTaken is number
                  && request.resource.data.timeTaken >= 0))
          && request.resource.data.answers is list
          && request.resource.data.completedAt == request.time;

      allow update, delete: if false;

      // Only authenticated teachers can read class results/gradebook
      allow read: if isTeacher();
    }

    // ──────────────────────────────────────────────────────────────
    // Everything else
    // ──────────────────────────────────────────────────────────────
    // Default: every other collection/path is DENIED.
  }
}